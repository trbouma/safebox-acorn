ACORN_TEST_WALLET_CONFIG=./.acorn-test/test-wallet.yml
ACORN_TEST_CREATE_WALLET=true
ACORN_TEST_BURN_AFTER=true
ACORN_TEST_RELAY=ws://beelink:7777
# Optional: when set, live tests also run against this external relay using
# separate disposable wallet configs.
# ACORN_THIRD_PARTY_RELAY=wss://relay.example.com
# Optional relay scenario selector: all, controlled, or third-party.
# ACORN_RELAY_SCENARIO=all controlled third-party
# Optional override for ecash transfer events; defaults to ACORN_TEST_RELAY.
# Leave unset when you want the third-party relay scenario to use
# ACORN_THIRD_PARTY_RELAY for transfer events too.
# ACORN_TEST_TRANSFER_RELAY=ws://beelink:7777
ACORN_SOURCE_CONFIG=~/.acorn/config.yml
# Optional direct source wallet override instead of ACORN_SOURCE_CONFIG:
# ACORN_SOURCE_NSEC=
# ACORN_SOURCE_RELAY=wss://relay.getsafebox.app
# Optional mint override for disposable test wallets. Leave unset to inherit
# the source wallet's relay-backed home mint.
# ACORN_TEST_MINT=https://mint.endfiat.money
# Optional receive-key override. Leave unset to use the source wallet nsec.
# ACORN_RECEIVE_NSEC=
# Optional: used only when ACORN_RECEIVE_NSEC is explicitly set. Otherwise the
# recipient npub is derived from the source wallet nsec.
# ACORN_RECIPIENT_NIP05=trbouma@getsafebox.app
ACORN_TEST_AMOUNT=1
ACORN_TEST_TIMEOUT=15
